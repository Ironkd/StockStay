# Backend environment variables (copy to server/.env for local use)
# Never commit real secrets. Use different values per environment (local / staging / production).
# See docs/environments.md for the full matrix.

# local | staging | production
APP_ENV=local

# development locally; production on Railway (staging and live)
NODE_ENV=development

PORT=3000

# Docker Compose (default local): docker compose up -d
DATABASE_URL=postgresql://stockstay:stockstay@localhost:5433/stockstay
# Supabase (staging/prod or optional local-dev project):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Required when APP_ENV is staging or production
JWT_SECRET=dev-only-change-me

# Comma-separated frontend origins (include Capacitor origins are added automatically when set)
CORS_ORIGIN=http://localhost:5173

# Used for password-reset, invite, and verification links
APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Email (Resend preferred; optional in local)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Stock Stay <onboarding@resend.dev>
# Or SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Stripe — use test keys for local/staging, live keys for production only
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
# STRIPE_EXTRA_USER_PRICE_ID=price_...
