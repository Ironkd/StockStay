generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  name                       String
  firstName                  String?
  lastName                   String?
  password                   String
  address                    String?   @default("")
  streetAddress              String?
  city                       String?
  province                   String?
  postalCode                 String?
  phone                      String?   @default("")
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  activeTeamId               String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  activeTeam          Team?                 @relation("UserActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)
  memberships         UserMembership[]
  passwordResetTokens PasswordResetToken[]
  ownedOrganizations  Organization[]        @relation("OrganizationOwner")

  @@index([activeTeamId])
  @@index([email])
  @@index([emailVerificationToken])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Organization {
  id                         String    @id @default(uuid())
  name                       String
  ownerId                    String
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  // Billing / plan info (moved from Team)
  plan                       String    @default("free") // "free", "starter", "pro"
  maxProperties              Int?
  extraUserSlots             Int?      @default(0)

  // Trial fields
  isOnTrial                  Boolean   @default(false)
  trialEndsAt                DateTime?
  trialPlan                  String?

  // Stripe billing
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  stripeSubscriptionStatus   String?
  billingInterval            String? // "month" | "year"

  // Invoice branding (one brand per org)
  invoiceLogoUrl             String?
  invoiceStyle               String? // JSON

  owner User   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  teams Team[]

  @@index([ownerId])
  @@index([isOnTrial])
  @@index([trialEndsAt])
  @@index([stripeCustomerId])
}

enum UnitDimension {
  count
  volume
  mass
  length
  other
}

model Team {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  ownerId          String
  /** IANA timezone for billing period boundaries (Q1b). */
  billingTimezone  String   @default("America/Toronto")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    UserMembership[]
  activeUsers    User[]           @relation("UserActiveTeam")
  properties     Property[]
  stockLocations StockLocation[]
  supplyItems    SupplyItem[]
  skus           Sku[]
  stockTransactions StockTransaction[]
  replenishments Replenishment[]
  clients        Client[]
  invoices       Invoice[]

  @@index([organizationId])
  @@index([ownerId])
}

model UserMembership {
  id                 String   @id @default(uuid())
  userId             String
  teamId             String
  teamRole           String   @default("member") // "owner" | "member" | "viewer"
  maxInventoryItems  Int?
  allowedPages       String? // JSON array
  allowedPropertyIds String? // JSON array
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Property {
  id               String   @id @default(uuid())
  teamId           String
  name             String
  location         String?
  clientId         String?
  markupPercentage Decimal? @db.Decimal(9, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team           Team                    @relation(fields: [teamId], references: [id])
  client         Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stockLocations StockLocationProperty[]
  replenishments Replenishment[]
  invoiceLines   InvoiceLine[]

  @@index([teamId])
  @@index([clientId])
}

model UnitOfMeasure {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  dimension UnitDimension  @default(count)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  supplyItems SupplyItem[]
}

model StockLocation {
  id         String    @id @default(uuid())
  teamId     String
  name       String
  address    String?
  tags       Json      @default("[]")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  team               Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  properties         StockLocationProperty[]
  stockOnHands       StockOnHand[]
  supplyThresholds   LocationSupplyThreshold[]
  replenishments     Replenishment[]

  @@unique([teamId, name])
  @@index([teamId])
  @@index([archivedAt])
}

model StockLocationProperty {
  id              String   @id @default(uuid())
  stockLocationId String
  propertyId      String
  createdAt       DateTime @default(now())

  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([stockLocationId, propertyId])
  @@index([stockLocationId])
  @@index([propertyId])
}

model SupplyItem {
  id                      String    @id @default(uuid())
  teamId                  String
  name                    String
  category                String    @default("")
  baseUnitId              String
  defaultReorderPoint     Decimal   @default(0) @db.Decimal(18, 6)
  defaultReorderQuantity  Decimal   @default(0) @db.Decimal(18, 6)
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  team               Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  baseUnit           UnitOfMeasure             @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  skus               Sku[]
  locationThresholds LocationSupplyThreshold[]
  replenishmentLines ReplenishmentLine[]

  @@unique([teamId, name])
  @@index([teamId])
  @@index([baseUnitId])
  @@index([category])
  @@index([archivedAt])
}

model Sku {
  id            String    @id @default(uuid())
  teamId        String
  supplyItemId  String
  name          String
  supplier      String?
  packSize      Decimal   @db.Decimal(18, 6)
  purchasePrice Decimal   @db.Decimal(18, 4)
  unitRate      Decimal   @db.Decimal(18, 6)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  supplyItem         SupplyItem          @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)
  stockOnHands       StockOnHand[]
  replenishmentLines ReplenishmentLine[]

  @@unique([teamId, name])
  @@index([teamId])
  @@index([supplyItemId])
  @@index([archivedAt])
}

model StockOnHand {
  id                String   @id @default(uuid())
  skuId             String
  stockLocationId   String
  quantity          Decimal  @default(0) @db.Decimal(18, 6)
  lastPurchasePrice Decimal? @db.Decimal(18, 4)
  lastUnitRate      Decimal? @db.Decimal(18, 6)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sku           Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)

  @@unique([skuId, stockLocationId])
  @@index([skuId])
  @@index([stockLocationId])
}

enum StockEntityType {
  stock_on_hand
  property_stock
}

enum StockTransactionType {
  receipt
  adjustment
  replenishment_out
  replenishment_in
  invoice
}

/** Reorder thresholds per Supply Item at a stock location (base units). */
model LocationSupplyThreshold {
  id               String   @id @default(uuid())
  stockLocationId  String
  supplyItemId     String
  reorderPoint     Decimal  @default(0) @db.Decimal(18, 6)
  reorderQuantity  Decimal  @default(0) @db.Decimal(18, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  supplyItem    SupplyItem    @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@unique([stockLocationId, supplyItemId])
  @@index([stockLocationId])
  @@index([supplyItemId])
}

model StockTransaction {
  id                String                @id @default(uuid())
  teamId            String
  entityType        StockEntityType
  entityId          String
  quantityDelta     Decimal               @db.Decimal(18, 6)
  transactionType   StockTransactionType
  postingId         String
  referenceType     String?
  referenceId       String?
  reason            String?
  /** Business date (e.g. purchase date on receipts); null → use createdAt */
  effectiveAt       DateTime?
  /** Pack purchase price recorded on receipt; null for non-receipt types */
  unitPrice         Decimal?              @db.Decimal(18, 4)
  createdByUserId   String?
  createdAt         DateTime              @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, effectiveAt])
  @@index([entityType, entityId])
  @@index([postingId])
  @@index([referenceType, referenceId])
  @@index([createdByUserId])
}

model Client {
  id                       String          @id @default(uuid())
  teamId                   String?
  name                     String
  email                    String          @default("")
  phone                    String          @default("")
  address                  String          @default("") // Legacy field
  streetAddress            String?         @default("")
  city                     String?         @default("")
  province                 String?         @default("")
  postalCode               String?         @default("")
  country                  String?         @default("")
  company                  String          @default("")
  notes                    String          @default("")
  defaultMarkupPercentage  Decimal         @default(0) @db.Decimal(9, 4)
  billingFrequency         BillingFrequency @default(monthly_eom)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  properties Property[]

  @@index([email])
  @@index([teamId])
}

enum BillingFrequency {
  weekly
  biweekly
  monthly_eom
}

enum ReplenishmentDirection {
  replenish
  return
}

enum ReplenishmentStatus {
  completed
}

model Replenishment {
  id                String                  @id @default(uuid())
  teamId            String
  stockLocationId   String
  propertyId        String
  direction         ReplenishmentDirection
  status            ReplenishmentStatus     @default(completed)
  performedByUserId String?
  transferGroupId   String?
  createdAt         DateTime                @default(now())

  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stockLocation StockLocation      @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  lines         ReplenishmentLine[]

  @@index([teamId, createdAt])
  @@index([propertyId])
  @@index([stockLocationId])
  @@index([transferGroupId])
}

model ReplenishmentLine {
  id               String   @id @default(uuid())
  replenishmentId  String
  skuId            String
  supplyItemId     String
  baseQtyDeployed  Decimal  @db.Decimal(18, 6)
  packQtyConsumed  Decimal  @db.Decimal(18, 6)
  unitRate         Decimal  @db.Decimal(18, 6)
  markupPercentage Decimal  @db.Decimal(9, 4)
  billBackAmount   Decimal  @db.Decimal(18, 4)
  billable         Boolean  @default(true)
  invoiced         Boolean  @default(false)
  reversesLineId   String?
  stockPostingId   String?
  createdAt        DateTime @default(now())

  replenishment Replenishment      @relation(fields: [replenishmentId], references: [id], onDelete: Cascade)
  sku           Sku                @relation(fields: [skuId], references: [id], onDelete: Restrict)
  supplyItem    SupplyItem         @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)
  reversesLine  ReplenishmentLine? @relation("ReplenishmentLineReversal", fields: [reversesLineId], references: [id], onDelete: SetNull)
  reversedBy    ReplenishmentLine[] @relation("ReplenishmentLineReversal")
  invoiceLine   InvoiceLine?

  @@index([replenishmentId])
  @@index([skuId])
  @@index([supplyItemId])
  @@index([invoiced])
  @@index([reversesLineId])
  @@index([stockPostingId])
}

model Invoice {
  id                  String    @id @default(uuid())
  teamId              String?
  invoiceNumber       String
  clientId            String?
  clientName          String    @default("")
  date                String // ISO date string (invoice issue date)
  dueDate             String? // ISO date string
  items               String    @default("[]") // Legacy JSON array; scheduled invoices use InvoiceLine
  billingPeriodStart  DateTime?
  billingPeriodEnd    DateTime?
  taxRate             Decimal   @default(0) @db.Decimal(9, 4)
  subtotal            Float     @default(0)
  tax                 Float     @default(0)
  total               Float     @default(0)
  status              String    @default("draft") // draft, sent, paid, overdue
  notes               String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  team   Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lines  InvoiceLine[]

  @@index([clientId])
  @@index([invoiceNumber])
  @@index([teamId])
  @@index([teamId, clientId, billingPeriodStart])
}

model InvoiceLine {
  id                   String   @id @default(uuid())
  invoiceId            String
  propertyId           String?
  replenishmentLineId  String?  @unique
  description          String
  quantity             Decimal  @db.Decimal(18, 6)
  unitPrice            Decimal  @db.Decimal(18, 6)
  amount               Decimal  @db.Decimal(18, 4)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  invoice           Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  property          Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  replenishmentLine ReplenishmentLine? @relation(fields: [replenishmentLineId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([propertyId])
}

model Invitation {
  id                 String    @id @default(uuid())
  teamId             String
  email              String
  teamRole           String    @default("member")
  maxInventoryItems  Int?
  allowedPages       String? // JSON array
  allowedPropertyIds String? // JSON array
  status             String    @default("pending") // pending, accepted, expired
  token              String    @unique
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  invitedByUserId    String?
  acceptedAt         DateTime?
  acceptedByUserId   String?

  @@index([teamId])
  @@index([token])
  @@index([email])
}
