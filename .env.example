# Frontend environment (copy to .env for local Vite)
# Full catalog: docs/operations.md — matrix: docs/environments.md

# Local API
VITE_API_BASE_URL=http://localhost:3000/api

# Staging (set in Vercel Staging / Preview — build-time):
# VITE_API_BASE_URL=https://your-staging-api.up.railway.app/api

# Production (set in Vercel Production — build-time):
# VITE_API_BASE_URL=https://api.stockstay.com/api

# Address autocomplete (Google Places). Optional – if unset, address fields stay manual.
# Get a key at https://console.cloud.google.com/ and enable "Places API" and "Maps JavaScript API".
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Umami Cloud analytics (optional). Both required to enable; app no-ops if unset.
# From https://cloud.umami.is — Website → Tracking code
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-id
